# Multi-stage build for sumdbproxy
FROM golang:alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /bin/sumdbproxy ./sumdb/cmd/proxy.go

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /bin/sumdbproxy /usr/local/bin/sumdbproxy

EXPOSE 8089

ENTRYPOINT ["/usr/local/bin/sumdbproxy"]
CMD ["--listen=:8089"]
